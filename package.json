{
  "name": "findfound",
  "productName": "Find & Found",
  "version": "1.0.0",
  "description": "Find & Found — lost & found, property, safety alerts and help nearby on a satellite map.",
  "author": "Find & Found",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "desktop": "electron .",
    "build:win": "electron-builder --win --publish never",
    "android:add": "cap add android",
    "android:sync": "cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.findfound",
    "productName": "Find & Found",
    "copyright": "© 2026 Find & Found. All rights reserved.",
    "files": ["electron/**", "www/**", "package.json"],
    "directories": { "output": "dist" },
    "win": { "target": ["nsis", "portable"], "icon": "resources/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "artifactName": "FindFound-Setup-${version}.${ext}", "shortcutName": "Find & Found" },
    "portable": { "artifactName": "FindFound-Portable-${version}.${ext}" }
  }
}
